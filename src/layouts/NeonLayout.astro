---
import { site } from "../utils/site";
import { estudio } from "../utils/estudio";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = `${site.name} — ${title}`;

// Datos estructurados: un estudio de software con base local.
//
// `foundingDate` sale de `estudio.desde` y solo se emite si ese año está
// cargado. Un dato estructurado inventado es peor que uno ausente: acá se
// declara lo mismo que dice la página, ni más.
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Norware Studio",
  description: site.description,
  url: site.url,
  email: site.email,
  ...(estudio.desde !== null ? { foundingDate: String(estudio.desde) } : {}),
  areaServed: {
    "@type": "City",
    name: "Río Cuarto",
    containedInPlace: { "@type": "State", name: "Córdoba, Argentina" },
  },
  knowsAbout: [
    "Desarrollo de software a medida",
    "Sistemas de gestión para pymes",
    "Sistemas multi-empresa con roles y permisos",
    "Integraciones NFC y QR",
    "Integración de pagos y notificaciones",
    "Software para inmobiliarias",
    "Sistema para talleres mecánicos y lubricentros",
    "Control de stock para comercios",
    "Ecommerce",
    "Automatización de procesos",
    "Inteligencia artificial aplicada",
  ],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14100E" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Norware" />
    <meta property="og:url" content={site.url} />
    <!-- La tarjeta que aparece cuando alguien pasa el link por WhatsApp -->
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.tagline} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />

    <title>{fullTitle}</title>

    <script type="application/ld+json" set:html={jsonLd} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!--
      Dos familias, no cuatro. Se fueron Space Grotesk (geométrica, de
      producto), JetBrains Mono (terminal) e Instrument Serif. Queda
      Fraunces para los títulos —serif blanda, cálida, con pesos reales—
      e Inter para todo lo demás.
    -->
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js-motion");
      }
    </script>
  </head>

  <body class="neon-body">
    <a href="#contenido" class="skip-link">Ir al contenido</a>
    <slot />
  </body>
</html>

<style is:global>
  /* ==========================================================
     NORWARE V6 · NEGRO CÁLIDO

     La v4 era obsidiana azulada con neón violeta: retícula de
     plano, marcos de luz, monoespaciada en 92 lugares, índice
     01/10. Ese es el lenguaje de una herramienta para devs.

     La v5 lo pasó a papel claro suponiendo que las referencias
     eran claras. Mirándolas de verdad, no: thoughtbot es negro
     amarronado y basement es negro puro.

     La conclusión: lo oscuro nunca fue el problema, el problema
     era el vocabulario. Así que el fondo vuelve a ser oscuro
     —cálido, no azulado— y todo el vocabulario de terminal se
     queda afuera: sin mono, sin neón, sin grilla, sin índice.
     ========================================================== */

  :root {
    --paper: #14100e;
    --paper-2: #1c1714;
    --paper-3: #241d19;

    --line: rgba(240, 235, 231, 0.14);
    --line-soft: rgba(240, 235, 231, 0.08);
    --line-strong: rgba(240, 235, 231, 0.28);

    --ink: #f0ebe7;
    --ink-2: #a79e97;
    --ink-3: #8a817a;

    --order: #a883ff;
    --order-wash: rgba(168, 131, 255, 0.13);
    --depth: #7aa2ff;
    --depth-wash: rgba(122, 162, 255, 0.13);
    --chaos: #ff8a5c;
    --chaos-wash: rgba(255, 138, 92, 0.13);

    --rx: 0deg;
    --ry: 0deg;
    --tz: 0px;
    --mx: 50%;
    --my: 0%;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    /* Deja aire bajo el header fijo cuando se salta a un ancla. */
    scroll-padding-top: 92px;
    -webkit-text-size-adjust: 100%;
  }

  .neon-body {
    min-height: 100vh;
    font-family: Inter, system-ui, sans-serif;
    color: var(--ink);
    /* Sin retícula de plano de fondo: era la firma más "blueprint". */
    background-color: var(--paper);
    letter-spacing: -0.006em;
    -webkit-font-smoothing: antialiased;
  }

  ::selection {
    background: var(--order-wash);
    color: var(--ink);
  }

  img,
  svg,
  canvas {
    display: block;
    max-width: 100%;
  }

  h1,
  h2,
  h3,
  h4,
  .font-display {
    font-family: Fraunces, Georgia, serif;
    font-weight: 600;
    font-variation-settings: "SOFT" 30, "WONK" 0;
  }

  /* La palabra destacada del titular: misma familia, en itálica. */
  .accent {
    font-style: italic;
    font-weight: 500;
    font-variation-settings: "SOFT" 60, "WONK" 1;
  }

  /* -------------------------------------------------- etiquetas */
  /* Antes esto era JetBrains Mono y aparecía 92 veces: el sitio
     entero sonaba a consola. Misma clase, otra voz. */

  .mono,
  .font-mono {
    font-family: Inter, system-ui, sans-serif;
    font-feature-settings: "cv05" 1;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--order);
  }
  .tag::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: currentColor;
  }
  .tag--depth {
    color: var(--depth);
  }
  .tag--chaos {
    color: var(--chaos);
  }

  .index {
    font-family: Inter, system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .rule {
    height: 1px;
    width: 100%;
    background: var(--line);
    transform-origin: left center;
  }

  /* ------------------------------------------------------ ficha */
  /* Era `blade`: cristal oscuro con un marco de neón desplazado por
     detrás. Ahora es una ficha de papel: fondo claro, borde fino y
     una sombra baja. Se conserva el nombre de la clase. */

  .blade {
    position: relative;
    /* Esquinas bien blandas: es de lo más característico de thoughtbot. */
    border-radius: 20px;
    border: 1px solid var(--line);
    /* Sobre negro la elevación no se hace con sombra sino con una
       superficie más clara que el fondo. */
    background: var(--paper-2);
    box-shadow: none;
    transform-style: preserve-3d;
    transition:
      transform 0.45s cubic-bezier(0.16, 0.84, 0.28, 1),
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .blade:hover {
    border-color: var(--line-strong);
    background: var(--paper-3);
  }

  /* Los acentos ya no son resplandor: son un filo de color arriba. */
  .blade--depth {
    border-top: 2px solid var(--depth);
  }
  .blade--chaos {
    border-top: 2px solid var(--chaos);
  }
  .blade--flat {
    background: transparent;
  }

  .blade[data-tilt] {
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateZ(var(--tz));
    will-change: transform;
  }

  .layer-1,
  .layer-2 {
    /* La profundidad 3D se fue con la estética de neón. */
    transform: none;
  }

  /* Las marcas de esquina eran encuadre técnico: fuera. */
  .tick {
    display: none;
  }

  .scene,
  .scene-near {
    perspective: 1600px;
  }
  .d3 {
    transform-style: preserve-3d;
  }

  /* --------------------------------------------------- botones */

  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    padding: 1rem 1.6rem;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1),
      box-shadow 0.18s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }
  .btn:focus-visible {
    outline: 2px solid var(--order);
    outline-offset: 3px;
  }

  .btn-primary {
    /* Texto oscuro sobre el violeta claro: 8:1, y se ve más caro
       que blanco sobre violeta. */
    color: #1a1208;
    background: var(--order);
  }
  .btn-primary:hover {
    transform: translateY(-1px);
    background: #bda0ff;
  }
  .btn-primary:active {
    transform: translateY(0);
  }

  .btn-ghost {
    color: var(--ink);
    border: 1px solid var(--line-strong);
    background: transparent;
  }
  .btn-ghost:hover {
    transform: translateY(-1px);
    border-color: var(--ink);
    background: var(--paper-2);
  }
  .btn-ghost:active {
    transform: translateY(0);
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    color: var(--order);
    transition: color 0.25s ease;
  }
  .link-arrow svg {
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .link-arrow:hover {
    color: #c7aaff;
  }
  .link-arrow:hover svg {
    transform: translateX(3px);
  }

  /* ------------------------------------------------------ rubro */
  /* El visitante elige su rubro arriba de todo y la página le habla
     a él: cambia la bajada del hero y la pantalla de producto.
     Sin JS queda el primer rubro visible, que es un estado válido. */

  [data-rubro-panel] {
    display: none;
  }
  [data-rubro-panel="inmobiliarias"] {
    display: block;
  }
  html[data-rubro] [data-rubro-panel] {
    display: none;
  }
  html[data-rubro="inmobiliarias"] [data-rubro-panel="inmobiliarias"],
  html[data-rubro="talleres"] [data-rubro-panel="talleres"],
  html[data-rubro="ecommerce"] [data-rubro-panel="ecommerce"],
  html[data-rubro="a-medida"] [data-rubro-panel="a-medida"] {
    display: block;
  }

  html[data-rubro="inmobiliarias"] [data-rubro-row="inmobiliarias"],
  html[data-rubro="talleres"] [data-rubro-row="talleres"],
  html[data-rubro="ecommerce"] [data-rubro-row="ecommerce"],
  html[data-rubro="a-medida"] [data-rubro-row="a-medida"] {
    display: none;
  }

  [data-rubro-btn] {
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease;
  }
  [data-rubro-btn]:hover {
    border-color: var(--line-strong);
  }
  [data-rubro-btn].is-on {
    border-color: var(--order);
    background: var(--order-wash);
    color: var(--order);
  }

  .is-target {
    animation: target-pulse 2.4s ease-out 1;
  }
  @keyframes target-pulse {
    0%,
    100% {
      box-shadow: none;
    }
    18%,
    62% {
      box-shadow: 0 0 0 2px var(--order);
    }
  }

  /* ------------------------------------------------------- camino */
  /* Los dos públicos de la página: el que viene a ordenar un negocio
     y el que viene a construir un proyecto. Elegir camino solo cambia
     el bloque del hero; ninguna sección se esconde. */

  [data-via-panel] {
    display: none;
  }
  [data-via-panel="ordenar"] {
    display: block;
  }
  html[data-via] [data-via-panel] {
    display: none;
  }
  html[data-via="ordenar"] [data-via-panel="ordenar"],
  html[data-via="construir"] [data-via-panel="construir"] {
    display: block;
  }

  /* ------------------------------------------- estados iniciales */

  html.js-motion [data-reveal] {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
  }

  .skip-link {
    position: fixed;
    top: -60px;
    left: 1rem;
    z-index: 90;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    background: var(--order);
    color: #1a1208;
    font-weight: 600;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
    .blade[data-tilt] {
      transform: none !important;
    }
  }
</style>

<script>
  import "../scripts/motion";
</script>
