---
import { resultados } from "../../utils/prime";

/**
 * "Impacto real.<br />Resultados reales.": tarjetas con foto, cifra
 * gigante con animación de entrada por caracter y autor.
 * Grilla asimétrica: angosta+ancha / ancha+angosta.
 */
---

<section id="resultados" class="mx-auto max-w-[1280px] px-5 pt-28 sm:px-10 sm:pt-32">
  <p class="reveal text-[14px] font-medium text-[#616161]">
    <span class="braille" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></span>
    Resultados
  </p>
  <h2
    class="reveal pf-display mt-4 font-medium leading-[1.16] text-[#212121]"
    style="font-size: clamp(2rem, 3.4vw, 3rem);"
  >
    Impacto real.<br />Resultados reales.
  </h2>
  <p class="reveal mt-4 max-w-md text-[15.5px] leading-relaxed text-[#616161]">
    Lo que cambió en operaciones reales, sin promesas infladas.
  </p>

  <div class="mt-12 grid gap-4 lg:grid-cols-[38fr_62fr]">
    {
      resultados.map((r, i) => (
        <article
          class:list={[
            "reveal relative overflow-hidden rounded-2xl bg-[#1A1814]",
            // La segunda fila invierte los anchos alternando el orden visual
            i === 2 && "lg:order-4",
            i === 3 && "lg:order-3",
          ]}
        >
          <img src={r.foto} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
          <div
            class="absolute inset-0"
            style="background: linear-gradient(to bottom, rgba(10,9,8,0.6) 0%, rgba(10,9,8,0.22) 40%, rgba(10,9,8,0.82) 100%);"
            aria-hidden="true"
          />
          <div class="relative flex min-h-[440px] flex-col p-7 sm:min-h-[490px] sm:p-9">
            <p class="pf-onimg text-[14px] font-medium text-white/90">{r.autor}</p>

            <p
              class="pf-onimg odo pf-display mt-6 overflow-hidden font-medium leading-none text-white"
              style="font-size: clamp(3.4rem, 7.5vw, 6.5rem); letter-spacing: 0;"
              aria-label={r.valor}
            >
              {r.valor.split("").map((ch, j) => (
                <span
                  class="odo-char"
                  style={`transition-delay:${j * 45}ms`}
                  aria-hidden="true"
                >
                  {ch === " " ? " " : ch}
                </span>
              ))}
            </p>

            <p class="pf-onimg pf-display mt-5 max-w-[24ch] text-[22px] font-medium leading-snug text-white sm:text-[26px]">
              {r.frase}
            </p>

            <div class="mt-auto pt-8">
              <p class="pf-onimg text-[14.5px] font-medium text-white">{r.autor}</p>
              <p class="pf-onimg text-[13px] text-white/75">{r.detalle}</p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
