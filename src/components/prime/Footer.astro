---
import { site, whatsappDefault } from "../../utils/site";
import LogoMark from "./LogoMark.astro";

const columnas = [
  {
    titulo: "Productos",
    links: [
      { label: "Norware Inmobiliarias", href: "#productos" },
      { label: "autoficha360", href: "#productos" },
      { label: "Norware Tap", href: "#productos" },
      { label: "holamappi", href: "https://holamappi.com" },
    ],
  },
  {
    titulo: "Explorar",
    links: [
      { label: "Cómo funciona", href: "#como-funciona" },
      { label: "Rubros", href: "#rubros" },
      { label: "Casos", href: "#casos" },
      { label: "Resultados", href: "#resultados" },
    ],
  },
  {
    titulo: "Contacto",
    links: [
      { label: "WhatsApp", href: whatsappDefault },
      { label: site.email, href: `mailto:${site.email}` },
      { label: "Instagram", href: site.instagram },
    ],
  },
];

const anio = new Date().getFullYear();
---

<footer class="mt-28 border-t border-black/[0.05] bg-white sm:mt-32">
  <div class="mx-auto max-w-[1280px] px-5 pt-16 sm:px-10">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
      <!-- Marca + contacto directo -->
      <div>
        <a href="#" class="flex items-center gap-2" aria-label="Norware, inicio">
          <LogoMark class="h-[30px] w-[30px]" />
          <span class="pf-display text-[19px] font-semibold text-[#1A1814]">Norware</span>
        </a>
        <p class="mt-5 max-w-xs text-[15px] leading-relaxed text-[#616161]">
          Un estudio. Sistemas simples para negocios reales.
        </p>
        <p class="mt-2 text-[14px] text-[#9E9E9E]">¿Charlamos tu caso? {site.tiempoRespuesta}.</p>
        <a
          href={whatsappDefault}
          target="_blank"
          rel="noopener"
          class="mt-5 inline-flex items-center rounded-full bg-[#1A1814] px-5 py-2.5 text-[15px] font-medium text-white transition-colors hover:bg-black"
        >
          Hablar por WhatsApp
        </a>
      </div>

      <!-- Columnas -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          columnas.map((col) => (
            <nav aria-label={col.titulo}>
              <p class="text-[15px] font-semibold text-[#1A1814]">{col.titulo}</p>
              <ul class="mt-4 space-y-2.5">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.href.startsWith("http") ? "_blank" : undefined}
                      rel={l.href.startsWith("http") ? "noopener" : undefined}
                      class="break-words text-[14.5px] text-[#616161] transition-colors hover:text-[#1A1814]"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <!-- Legal -->
    <div class="mt-14 flex flex-col gap-3 border-t border-black/[0.06] py-6 text-[13.5px] text-[#9E9E9E] sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} Norware Studio · {site.city}</p>
      <p>Hecho en Río Cuarto · Soporte cercano, del que lo construyó</p>
    </div>
  </div>

  <!-- Wordmark gigante -->
  <div class="overflow-hidden px-2 pb-0" aria-hidden="true">
    <p
      class="pf-display select-none whitespace-nowrap text-center font-semibold leading-[0.78] tracking-[-0.03em] text-[#1A1814]"
      style="font-size: clamp(5rem, 16.5vw, 15.5rem); transform: translateY(12%);"
    >
      Norware
    </p>
  </div>
</footer>
