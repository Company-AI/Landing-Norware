---
import { ticker } from "../../utils/prime";

/**
 * Franja de clientes y productos con marquee continuo.
 * Son wordmarks tipográficos: no hay logos vectoriales de los
 * clientes locales, y un nombre real dice más que un logo inventado.
 */
const doble = [...ticker, ...ticker];
---

<div class="overflow-hidden border-b border-black/[0.05] py-9">
  <div class="pf-marquee flex w-max items-center gap-16 pr-16">
    {
      doble.map((nombre) => (
        <span class="whitespace-nowrap pf-display text-[19px] font-medium text-[#1A1814]/45">
          {nombre}
        </span>
      ))
    }
  </div>
</div>
