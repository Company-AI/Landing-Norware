---
import SectionHead from "./SectionHead.astro";
import { estudio, capacidades, productos, desdeTexto } from "../../utils/estudio";
import { whatsappLink } from "../../utils/site";

// El camino "construir" entero en UNA sección.
//
// Al principio esto eran dos (el estudio por un lado, los productos por
// otro) y entre las dos medían tres pantallas y media. Un visitante que
// quiere saber si podés construir lo suyo no necesita tres pantallas:
// necesita ver qué construiste, qué sabés hacer y cómo trabajás. En ese
// orden, porque lo concreto convence antes que lo abstracto.
//
// "Años de experiencia" es un dato (`estudio.desde`), no un adjetivo, y
// si estuviera en null la página ni lo menciona.
//
// El stack ya NO se muestra acá, aunque siga cargado en `estudio.ts`.
// De los cinco estudios que se tomaron de referencia, los dos más
// consolidados (Xmartlabs y basement) no muestran ninguna tecnología en
// la home, y el único que pone una tabla de stack es el menos armado del
// grupo. El cliente no compra Laravel: compra que el taller deje de
// perder el historial. El dato queda para una página de "cómo lo
// hacemos", si algún día existe.
//
// La pieza que no se toca aunque haya que recortar: la DECISIÓN que
// define a cada producto y, cuando existe, lo que el producto NO hace.
// Las dos salen de la documentación de cada repo. En una página que
// promete no vender humo, decir dónde está el límite vale más que
// cualquier adjetivo.

const desde = desdeTexto();

const marcadores = [
  desde ? { valor: String(estudio.desde), etiqueta: "Trabajando desde" } : null,
  {
    valor: String(productos.length).padStart(2, "0"),
    etiqueta: productos.length === 1 ? "Producto propio" : "Productos propios",
  },
  { valor: "Río Cuarto", etiqueta: "Córdoba, Argentina" },
].filter((m): m is { valor: string; etiqueta: string } => m !== null);

const waProyecto = whatsappLink(
  "Hola Norware, tengo un proyecto para construir y quiero contarles de qué se trata."
);
---

<section id="estudio" class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(52% 55% at 18% 15%, rgba(76,110,245,.12), transparent 60%);"
    aria-hidden="true">
  </div>

  <div class="relative mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-12 lg:py-20">
    <div class="grid gap-8 lg:grid-cols-2 lg:gap-16">
      <SectionHead tag="El estudio" tone="depth">
        Un estudio de software, no una fábrica de <span class="accent text-order">páginas</span>
      </SectionHead>

      <p
        class="max-w-[38ch] text-[17px] leading-relaxed text-ink-2 lg:pt-14"
        data-reveal
        data-reveal-delay="0.08"
      >
        {desde ? `Desde ${estudio.desde} en ${estudio.ciudad}.` : `${estudio.ciudad}.`}
        {" "}Pensamos, construimos y bancamos el sistema. Todo acá adentro.
      </p>
    </div>

    <!-- Marcadores: solo datos que se pueden chequear -->
    <ul
      class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-3"
      data-reveal
    >
      {
        marcadores.map((m) => (
          <li class="bg-paper px-5 py-5">
            <p class="font-display text-[26px] font-semibold leading-none text-ink">
              {m.valor}
            </p>
            <p class="mono mt-2 text-[11px] uppercase tracking-[0.18em] text-ink-3">
              {m.etiqueta}
            </p>
          </li>
        ))
      }
    </ul>

    <!-- ================================= LO QUE YA CONSTRUIMOS -->
    <div class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4" data-reveal>
        <h3 class="font-display text-d3 font-semibold text-ink">Productos propios</h3>
        <p class="mono text-[11px] uppercase tracking-[0.2em] text-ink-3">
          Hechos enteros acá, sin tercerizar el pedazo difícil
        </p>
      </div>
      <div class="rule mt-6" data-reveal data-reveal-delay="0.05"></div>

      <div class="scene mt-8 grid gap-7 lg:grid-cols-2">
        {
          productos.map((p, i) => (
            <article
              class:list={["blade d3 h-full p-6 sm:p-7", p.tone === "depth" && "blade--depth"]}
              style="--blade-d: 12px;"
              data-reveal
              data-reveal-delay={String(i * 0.06)}
              data-tilt
              data-tilt-max="4"
              data-tilt-lift="10"
            >
              <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                <h4 class="font-display text-[19px] font-semibold tracking-[-0.02em] text-ink">
                  {p.nombre}
                </h4>
                {/* El estado se escribe tal cual está en `estudio.ts`. */}
                <span class="mono text-[11px] uppercase tracking-[0.16em] text-order">
                  {p.estado}
                </span>
              </div>

              <p class="mt-3 text-[15px] font-medium text-ink">{p.resumen}</p>

              <div class="mt-5 border-t border-line-soft pt-4">
                <p class="mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
                  La decisión que lo define
                </p>
                <p class="mt-2 font-display text-[15px] font-semibold leading-snug text-ink">
                  {p.decision.titulo}
                </p>
                <p class="mt-2 text-[13.5px] leading-relaxed text-ink-2">
                  {p.decision.texto}
                </p>
              </div>

              {p.noHace && (
                <p class="mt-4 flex items-start gap-2.5 text-[13px] leading-relaxed text-ink-2">
                  <span
                    class="mt-[5px] h-2 w-2 shrink-0 rotate-45 border border-chaos bg-chaos/30"
                    aria-hidden="true"
                  />
                  <span>
                    <span class="mono text-[11px] uppercase tracking-[0.16em] text-chaos">
                      Lo que no hace ·{" "}
                    </span>
                    {p.noHace}
                  </span>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>

    <!-- ======================================= QUÉ MÁS CONSTRUIMOS -->
    <div class="mt-10">
      <h3 class="font-display text-d3 font-semibold text-ink" data-reveal>
        Qué construimos
      </h3>
      <div class="rule mt-6" data-reveal data-reveal-delay="0.05"></div>

      <ul class="mt-2 grid border-line md:grid-cols-2 md:gap-x-12">
        {
          capacidades.map((cap, i) => (
            <li
              class="border-b border-line py-4"
              data-reveal
              data-reveal-delay={String((i % 2) * 0.05)}
            >
              <div class="flex items-baseline gap-3">
                <span
                  class:list={[
                    "h-2 w-2 shrink-0 translate-y-[-1px] rotate-45 border",
                    i % 2 === 1 ? "border-depth bg-depth/40" : "border-order bg-order/40",
                  ]}
                  aria-hidden="true"
                />
                <p class="font-display text-[15px] font-semibold text-ink">{cap.titulo}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!--
      Acá había un bloque "cómo se construye acá adentro" con cuatro
      prácticas de ingeniería. Se sacó porque la sección "Cómo trabajamos"
      que viene justo después ocupa el mismo terreno para el visitante, y
      lo dice en su idioma: pasos de un trabajo, no prácticas de código.
      Los datos siguen en `oficio`, dentro de estudio.ts.
    -->

    <div
      class="mt-10 flex flex-col gap-4 border-t border-line pt-7 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="max-w-[30ch] font-display text-[19px] font-semibold text-ink">
        ¿Tenés algo para construir?
      </p>
      <a href={waProyecto} target="_blank" rel="noopener" class="btn btn-primary shrink-0">
        Contanos tu proyecto
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
