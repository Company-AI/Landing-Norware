---
// Encabezado de sección.
//
// Antes mostraba "01 / 10" al lado de la etiqueta. Numerar las secciones
// es vocabulario de documentación técnica: ninguno de los estudios que se
// tomaron de referencia lo hace, y para el dueño de una pyme el número no
// significa nada. Queda solo la etiqueta.
//
// El orden real de la página sigue declarado en `secciones.ts`, que es de
// donde salen los dos caminos del hero.
interface Props {
  tag: string;
  tone?: "order" | "depth" | "chaos";
  class?: string;
}

const { tag, tone = "order", class: klass = "" } = Astro.props;
---

<header class:list={["relative", klass]}>
  <span
    class:list={[
      "tag",
      tone === "depth" && "tag--depth",
      tone === "chaos" && "tag--chaos",
    ]}
    data-reveal
  >
    {tag}
  </span>

  <h2
    class="mt-5 max-w-[17ch] font-display text-d2 font-semibold text-ink"
    data-reveal
    data-reveal-delay="0.05"
  >
    <slot />
  </h2>

  <slot name="intro" />

  <div class="rule mt-8" data-reveal data-reveal-delay="0.1"></div>
</header>
