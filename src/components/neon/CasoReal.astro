---
import SectionHead from "./SectionHead.astro";
import { casos } from "../../utils/negocio";

// Los casos salen de `negocio.ts`. Si un caso tiene métrica o testimonio
// cargado, la sección los muestra; si no, no inventa nada.
const publicables = casos.filter((c) => c.autorizado);
const caso = publicables.find((c) => c.antes && c.solucion && c.despues);
const otros = publicables.filter((c) => c !== caso);

// Los campos pueden faltar (ver `Caso` en negocio.ts): se arma la línea
// con lo que haya en vez de dejar un " · " colgando.
// El sistema va primero: en una lista de clientes, lo que le importa al
// que la lee es QUÉ se construyó, no en qué rubro está la empresa.
function meta(c: { sistema?: string; rubro?: string; ciudad?: string }): string {
  return [c.sistema, c.rubro, c.ciudad].filter(Boolean).join(" · ");
}

const etapas = caso
  ? [
      { etiqueta: "Antes", texto: caso.antes!, tone: "chaos" },
      { etiqueta: "Solución", texto: caso.solucion!, tone: "depth" },
      { etiqueta: "Después", texto: caso.despues!, tone: "order" },
    ]
  : [];
---

<section id="caso-real" class="relative border-b border-line">
  <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-12 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.8fr] lg:gap-16">
      <SectionHead tag="Caso real">
        Quién ya está trabajando más <span class="accent text-order">ordenado</span>
      </SectionHead>

      {
        caso && (
          <div class="scene-near self-end" data-reveal data-reveal-delay="0.08">
            <div class="blade d3 p-7" data-tilt data-tilt-max="7" data-tilt-lift="16">
              <div class="flex items-center gap-3">
                <span
                  class="h-2 w-2 rounded-full bg-order"
                />
                <p class="font-display text-[18px] font-semibold text-ink">
                  {caso.empresa}
                </p>
              </div>
              {meta({ rubro: caso.rubro, ciudad: caso.ciudad }) && (
                <p class="mono mt-3 text-[11px] uppercase tracking-[0.18em] text-ink-3">
                  {meta({ rubro: caso.rubro, ciudad: caso.ciudad })}
                </p>
              )}
              {caso.duenio && (
                <p class="mt-1.5 text-[13px] text-ink-2">{caso.duenio}, dueño</p>
              )}
              {caso.resumen && (
                <p class="layer-1 mt-5 text-[14.5px] leading-relaxed text-ink-2">
                  {caso.resumen}
                </p>
              )}

              {caso.metrica && (
                <div class="mt-6 border-t border-line pt-5">
                  <p class="font-display text-d3 font-semibold text-order">
                    {caso.metrica.valor}
                  </p>
                  <p class="mt-1 text-[13.5px] text-ink-2">{caso.metrica.detalle}</p>
                </div>
              )}
            </div>
          </div>
        )
      }
    </div>

    <!--
      Acá había un tríptico Antes / Solución / Después: tres párrafos para
      contar lo que el número de arriba ya dice. Se sacó por eso. Los textos
      siguen en `negocio.ts` (campos antes/solucion/despues) para el día que
      cada caso tenga página propia.
    -->

    {
      caso?.testimonio && (
        <blockquote class="blade mt-14 px-8 py-9" style="--blade-d: 12px;" data-reveal>
          <p class="max-w-[52ch] font-display text-[20px] font-medium leading-snug text-ink sm:text-[23px]">
            “{caso.testimonio.texto}”
          </p>
          <footer class="mono mt-6 text-[11px] uppercase tracking-[0.18em] text-order">
            {caso.testimonio.autor}
          </footer>
        </blockquote>
      )
    }

    {
      otros.length > 0 && (
        <div class="mt-14 border-t border-line pt-10" data-reveal>
          <p class="mono text-[11px] uppercase tracking-[0.2em] text-ink-3">
            También trabajan con nosotros
          </p>
          <ul class="mt-5 flex flex-wrap gap-3">
            {otros.map((c) => (
              <li class="flex items-center gap-3 rounded-xl border border-line bg-paper-2 px-4 py-3">
                <span
                  class="h-2 w-2 rounded-full bg-order"
                  aria-hidden="true"
                />
                <span>
                  <span class="block font-display text-[14.5px] font-medium text-ink">
                    {c.empresa}
                  </span>
                  {meta(c) && (
                    <span class="mono mt-1 block text-[11px] uppercase tracking-[0.16em] text-ink-3">
                      {meta(c)}
                    </span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-14" data-reveal>
      <a href="#diagnostico" class="link-arrow text-[15.5px]">
        Quiero algo similar para mi negocio
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
