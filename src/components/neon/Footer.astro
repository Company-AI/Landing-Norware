---
import { site, navItems, productLines, whatsappDefault } from "../../utils/site";

const year = new Date().getFullYear();
---

<footer class="relative bg-void-2 pb-24 lg:pb-0">
  <div class="mx-auto max-w-[1400px] px-5 py-16 sm:px-8 lg:px-12 lg:py-20">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-3" aria-label="Norware, inicio">
          <span class="h-6 w-6 rotate-45 border border-order/60 bg-order/15" style="box-shadow:0 0 18px -4px rgba(155,92,255,.9)" aria-hidden="true"></span>
          <span class="font-display text-[20px] font-bold tracking-[-0.03em] text-ink">
            Norware
          </span>
        </a>

        <p class="mt-6 max-w-sm text-[14.5px] leading-relaxed text-ink-2">
          Convertimos procesos desordenados en sistemas simples para que tu
          negocio funcione mejor.
        </p>

        <p class="mono mt-8 text-[10px] uppercase tracking-[0.18em] text-ink-3">
          {site.city}
        </p>

        <div class="mt-3 flex flex-col gap-2">
          <a
            href={`mailto:${site.email}`}
            class="w-fit text-[14px] text-ink-2 transition-colors hover:text-order"
          >
            {site.email}
          </a>
          <a
            href={whatsappDefault}
            target="_blank"
            rel="noopener"
            class="w-fit text-[14px] text-ink-2 transition-colors hover:text-order"
          >
            Hablar por WhatsApp
          </a>
          <a
            href={site.instagram}
            target="_blank"
            rel="noopener"
            class="flex w-fit items-center gap-2 text-[14px] text-ink-2 transition-colors hover:text-order"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line>
            </svg>
            @norwarestudio
          </a>
        </div>
      </div>

      <nav aria-label="Soluciones">
        <p class="mono text-[10px] uppercase tracking-[0.2em] text-ink-3">Soluciones</p>
        <ul class="mt-5 space-y-3">
          {
            productLines.map((line) => (
              <li>
                <a
                  href={line.href}
                  class="text-[14px] text-ink-2 transition-colors hover:text-ink"
                >
                  {line.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Sitio">
        <p class="mono text-[10px] uppercase tracking-[0.2em] text-ink-3">Sitio</p>
        <ul class="mt-5 space-y-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[14px] text-ink-2 transition-colors hover:text-ink"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="rule mt-14"></div>

    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[13px] text-ink-3">
        {year} Norware Studio. Software para empresas que quieren trabajar más
        ordenadas.
      </p>
      <p class="mono text-[10px] uppercase tracking-[0.2em] text-ink-3">
        Río Cuarto · ARG
      </p>
    </div>
  </div>
</footer>
