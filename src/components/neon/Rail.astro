---
import { whatsappDefault } from "../../utils/site";

// Riel vertical (arquitectura de la v2) en cristal oscuro con luz verde.
const links = [
  { n: "01", label: "Así se ve", href: "#producto" },
  { n: "02", label: "Lo que pasa hoy", href: "#problema" },
  { n: "03", label: "Qué ofrecemos", href: "#soluciones" },
  { n: "04", label: "Caso real", href: "#caso-real" },
  { n: "05", label: "Precio", href: "#precio" },
  { n: "06", label: "Cómo trabajamos", href: "#proceso" },
  { n: "07", label: "IA con criterio", href: "#ia" },
  { n: "08", label: "Preguntas", href: "#faq" },
  
  { n: "09", label: "Diagnóstico", href: "#diagnostico" },
];
---

<!-- ===================== RIEL (escritorio) ===================== -->
<aside
  class="rail fixed inset-y-0 left-0 z-50 hidden w-[88px] flex-col items-center justify-between border-r border-white/[0.08] py-6 lg:flex"
  aria-label="Navegación principal"
>
  <a href="/" class="group flex flex-col items-center gap-3.5" aria-label="Norware, inicio">
    <span class="scene-near block">
      <span class="logo-cube d3" aria-hidden="true">
        <i style="transform: translateZ(13px)"></i>
        <i style="transform: rotateY(180deg) translateZ(13px)"></i>
        <i style="transform: rotateY(90deg) translateZ(13px)"></i>
        <i style="transform: rotateY(-90deg) translateZ(13px)"></i>
        <i style="transform: rotateX(90deg) translateZ(13px)"></i>
        <i style="transform: rotateX(-90deg) translateZ(13px)"></i>
      </span>
    </span>
    <span
      class="font-display text-[13px] font-semibold uppercase tracking-[0.18em] text-ink"
      style="writing-mode: vertical-rl;"
    >
      Norware
    </span>
  </a>

  <nav class="relative flex flex-1 flex-col items-center justify-center gap-1.5">
    <span
      class="absolute left-1/2 top-0 h-full w-px -translate-x-1/2 bg-white/[0.09]"
      aria-hidden="true"></span>
    <span
      id="rail-progress"
      class="absolute left-1/2 top-0 h-full w-px origin-top -translate-x-1/2 scale-y-0 bg-order"
      style="box-shadow: 0 0 12px rgba(155,92,255,.9);"
      aria-hidden="true"></span>

    {
      links.map((l) => (
        <a href={l.href} data-rail-link class="dot group relative z-10 flex h-7 w-7 items-center justify-center">
          <span class="mono text-[9.5px] tracking-[0.1em] text-ink-3 transition-colors">
            {l.n}
          </span>
          <span class="tip mono pointer-events-none absolute left-[38px] whitespace-nowrap rounded border border-order/30 bg-void-3 px-2.5 py-1.5 text-[9.5px] uppercase tracking-[0.14em] text-order opacity-0 transition-all duration-300">
            {l.label}
          </span>
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col items-center gap-3">
    <a
      href={whatsappDefault}
      target="_blank"
      rel="noopener"
      aria-label="Hablar por WhatsApp"
      class="flex h-10 w-10 items-center justify-center rounded border border-white/[0.12] bg-white/[0.03] text-ink-2 transition-all duration-200 hover:-translate-y-0.5 hover:border-order/50 hover:text-order"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.83 14.12c-.25.7-1.45 1.33-2.02 1.42-.51.08-1.16.11-1.87-.12-.43-.14-.99-.32-1.7-.63-2.99-1.29-4.94-4.3-5.09-4.5-.15-.2-1.22-1.62-1.22-3.09 0-1.47.77-2.19 1.05-2.49.27-.3.6-.37.8-.37.2 0 .4 0 .57.01.18.01.43-.07.67.51.25.6.85 2.07.92 2.22.08.15.13.33.03.53-.1.2-.15.32-.3.5-.15.17-.31.39-.44.52-.15.15-.31.31-.13.61.17.3.77 1.27 1.65 2.06 1.14 1.01 2.09 1.33 2.39 1.48.3.15.47.13.65-.08.17-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.28.1 1.75.82 2.05.97.3.15.5.23.57.35.08.13.08.72-.18 1.42z"></path>
      </svg>
    </a>

    <a
      href="#diagnostico"
      class="flex items-center justify-center rounded bg-gradient-to-b from-[#B48CFF] to-[#8B4FEA] px-2.5 py-5 font-display text-[11px] font-semibold uppercase tracking-[0.18em] text-[#ffffff] transition-transform duration-200 hover:-translate-y-0.5"
      style="writing-mode: vertical-rl; box-shadow: 0 0 26px -6px rgba(155,92,255,.8);"
    >
      Diagnóstico
    </a>
  </div>
</aside>

<!-- ===================== DOCK (móvil) ===================== -->
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-white/[0.1] bg-void/95 backdrop-blur-xl lg:hidden">
  <div class="flex items-stretch">
    <a href="/" class="flex items-center gap-2.5 border-r border-white/[0.1] px-4" aria-label="Norware, inicio">
      <span class="h-6 w-6 rotate-45 border border-order/60 bg-order/15" aria-hidden="true"></span>
      <span class="font-display text-[15px] font-semibold tracking-[-0.02em] text-ink">
        Norware
      </span>
    </a>

    <button
      id="neon-menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="neon-sheet"
      class="mono flex flex-1 items-center justify-center gap-2 border-r border-white/[0.1] px-3 py-4 text-[11px] uppercase tracking-[0.18em] text-ink"
    >
      <span id="neon-menu-label">Índice</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <a
      href="#diagnostico"
      class="flex items-center bg-gradient-to-b from-[#B48CFF] to-[#8B4FEA] px-5 font-display text-[12.5px] font-semibold uppercase tracking-[0.12em] text-[#ffffff]"
    >
      Diagnóstico
    </a>
  </div>
</div>

<div id="neon-sheet" class="fixed inset-0 z-40 hidden bg-void/97 backdrop-blur-2xl lg:hidden">
  <div class="flex h-full flex-col overflow-y-auto px-5 pb-28 pt-12">
    <p class="tag">Índice</p>
    <ul class="mt-7">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="neon-close flex items-baseline gap-4 border-b border-white/[0.08] py-4 font-display text-[clamp(1.5rem,7vw,2.1rem)] font-semibold tracking-[-0.03em] text-ink transition-colors hover:text-order"
            >
              <span class="mono text-[11px] text-ink-3">{l.n}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={whatsappDefault}
      target="_blank"
      rel="noopener"
      class="neon-close btn btn-ghost mt-9 w-full"
    >
      Hablar por WhatsApp
    </a>
  </div>
</div>

<style>
  .rail {
    background: rgba(7, 9, 16, 0.82);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  .logo-cube {
    position: relative;
    display: block;
    width: 26px;
    height: 26px;
    animation: logo-spin 20s linear infinite;
  }
  .logo-cube i {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(155, 92, 255, 0.6);
    background: rgba(155, 92, 255, 0.07);
  }
  @keyframes logo-spin {
    0% {
      transform: rotateX(-24deg) rotateY(0deg);
    }
    100% {
      transform: rotateX(-24deg) rotateY(360deg);
    }
  }

  .dot::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    background: var(--order);
    box-shadow: 0 0 12px rgba(155, 92, 255, 0.9);
    transform: rotate(45deg) scale(0);
    transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .dot.is-active::before {
    transform: rotate(45deg) scale(1);
  }
  .dot.is-active span:first-of-type {
    opacity: 0;
  }
  .dot:hover span:first-of-type {
    color: var(--ink);
  }
  .dot:hover .tip,
  .dot:focus-visible .tip {
    opacity: 1;
    transform: translateX(4px);
  }
</style>

<script>
  /* Índice activo + progreso del riel. Sin GSAP: es barato y no depende
     de que el resto del movimiento esté disponible. */
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-rail-link]")
  );
  const progress = document.getElementById("rail-progress");

  const sections = links
    .map((link) => {
      const id = link.getAttribute("href")?.replace("#", "");
      const el = id ? document.getElementById(id) : null;
      return el ? { link, el } : null;
    })
    .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(x));

  let ticking = false;
  function update() {
    ticking = false;
    const mid = window.innerHeight * 0.45;
    let active: HTMLAnchorElement | null = null;
    sections.forEach(({ link, el }) => {
      const r = el.getBoundingClientRect();
      if (r.top <= mid && r.bottom >= mid) active = link;
    });
    links.forEach((l) => l.classList.toggle("is-active", l === active));

    if (progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.transform = `translateX(-50%) scaleY(${max > 0 ? window.scrollY / max : 0})`;
    }
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );
  window.addEventListener("resize", update);
  update();

  /* Hoja de índice en móvil */
  const btn = document.getElementById("neon-menu-btn");
  const sheet = document.getElementById("neon-sheet");
  const label = document.getElementById("neon-menu-label");

  function close() {
    sheet?.classList.add("hidden");
    btn?.setAttribute("aria-expanded", "false");
    document.body.style.removeProperty("overflow");
    if (label) label.textContent = "Índice";
  }
  function open() {
    sheet?.classList.remove("hidden");
    btn?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
    if (label) label.textContent = "Cerrar";
  }

  btn?.addEventListener("click", () => {
    btn.getAttribute("aria-expanded") === "true" ? close() : open();
  });
  document
    .querySelectorAll(".neon-close")
    .forEach((el) => el.addEventListener("click", close));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
