---
import SectionHead from "./SectionHead.astro";
import Pantalla from "./Pantalla.astro";

// Lo que más faltaba: mostrar el sistema. Cada rubro ve sus propias
// pantallas, elegidas con el selector del hero.
// MOCKUPS ILUSTRATIVOS — reemplazar por capturas reales del producto.
---

<section id="producto" class="relative border-b border-line bg-paper-2">
  <div class="relative mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-12 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHead tag="Así se ve">
        No te lo contamos. Te lo <span class="accent text-order">mostramos</span>
      </SectionHead>

      <p
        class="max-w-[52ch] text-[16.5px] leading-relaxed text-ink-2 lg:pt-20"
        data-reveal
        data-reveal-delay="0.08"
      >
        Así trabaja tu equipo todos los días. Cambiá el rubro arriba y vas a
        ver las pantallas de tu operación.
        <span class="mt-3 block text-[13.5px] text-ink-3">
          Ejemplos con datos ficticios: el sistema se configura con los tuyos.
        </span>
      </p>
    </div>

    <div class="mt-14">
      <!-- ============================ INMOBILIARIAS -->
      <div data-rubro-panel="inmobiliarias">
        <div class="grid gap-x-12 gap-y-14 lg:grid-cols-[1.25fr_1fr]" data-reveal>
          <Pantalla
            title="Contratos y vencimientos"
            pie="Así ves, de un vistazo, qué contrato vence y a quién hay que avisarle."
          >
            <table class="w-full text-left">
              <thead>
                <tr class="mono border-b border-line-soft text-[11px] uppercase tracking-[0.14em] text-ink-3">
                  <th class="px-4 py-2.5 font-normal">Propiedad</th>
                  <th class="px-4 py-2.5 font-normal">Tipo</th>
                  <th class="px-4 py-2.5 font-normal">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-soft">
                <tr class="bg-order/[0.05]">
                  <td class="px-4 py-3.5">
                    <p class="text-[13px] font-medium text-ink">Sobremonte 480</p>
                    <p class="mt-0.5 text-[11.5px] text-ink-3">Inq. M. Ferreyra</p>
                  </td>
                  <td class="px-4 py-3.5 text-[12.5px] text-ink-2">Alquiler</td>
                  <td class="px-4 py-3.5">
                    <span class="mono rounded border border-order/40 bg-order/10 px-2 py-1 text-[11px] uppercase tracking-wider text-order">
                      Vence en 12 días
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5">
                    <p class="text-[13px] font-medium text-ink">Belgrano 1120</p>
                    <p class="mt-0.5 text-[11.5px] text-ink-3">Inq. J. Ledesma</p>
                  </td>
                  <td class="px-4 py-3.5 text-[12.5px] text-ink-2">Alquiler</td>
                  <td class="px-4 py-3.5">
                    <span class="mono rounded border border-white/10 bg-paper-2 px-2 py-1 text-[11px] uppercase tracking-wider text-ink-2">
                      Al día
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5">
                    <p class="text-[13px] font-medium text-ink">Deán Funes 75</p>
                    <p class="mt-0.5 text-[11.5px] text-ink-3">Prop. R. Sosa</p>
                  </td>
                  <td class="px-4 py-3.5 text-[12.5px] text-ink-2">Venta</td>
                  <td class="px-4 py-3.5">
                    <span class="mono rounded border border-white/10 bg-paper-2 px-2 py-1 text-[11px] uppercase tracking-wider text-ink-2">
                      Con reserva
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </Pantalla>

          <Pantalla
            title="Ficha de la propiedad"
            meta="Sobremonte 480"
            pie="Toda la historia del contrato en una pantalla: pagos, ajustes y avisos."
          >
            <dl class="divide-y divide-line-soft">
              <div class="flex items-center justify-between px-4 py-3">
                <dt class="text-[12px] text-ink-3">Propietario</dt>
                <dd class="text-[12.5px] font-medium text-ink">R. Sosa</dd>
              </div>
              <div class="flex items-center justify-between px-4 py-3">
                <dt class="text-[12px] text-ink-3">Inquilino</dt>
                <dd class="text-[12.5px] font-medium text-ink">M. Ferreyra</dd>
              </div>
              <div class="flex items-center justify-between px-4 py-3">
                <dt class="text-[12px] text-ink-3">Próximo ajuste</dt>
                <dd class="text-[12.5px] font-medium text-order">en 12 días</dd>
              </div>
              <div class="flex items-center justify-between px-4 py-3">
                <dt class="text-[12px] text-ink-3">Pagos al día</dt>
                <dd class="text-[12.5px] font-medium text-ink">14 de 14</dd>
              </div>
            </dl>
            <div class="border-t border-line px-4 py-3.5">
              <span class="mono inline-flex items-center gap-2 rounded border border-order/40 bg-order/10 px-2.5 py-1.5 text-[11px] uppercase tracking-wider text-order">
                Enviar aviso por WhatsApp
              </span>
            </div>
          </Pantalla>
        </div>
      </div>

      <!-- ============================ TALLERES -->
      <div data-rubro-panel="talleres">
        <div class="grid gap-x-12 gap-y-14 lg:grid-cols-[1.25fr_1fr]" data-reveal>
          <Pantalla
            title="Turnos de hoy"
            meta="martes 12"
            pie="Así ves el día completo del taller sin abrir el cuaderno ni WhatsApp."
          >
            <ul class="divide-y divide-line-soft">
              <li class="flex items-center gap-4 px-4 py-3.5">
                <span class="mono w-12 shrink-0 text-[12px] text-ink-2">09:00</span>
                <div class="flex-1">
                  <p class="text-[13px] font-medium text-ink">Ford Ranger · AB 123 CD</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">Service 20.000 km</p>
                </div>
                <span class="mono rounded border border-white/10 bg-paper-2 px-2 py-1 text-[11px] uppercase tracking-wider text-ink-2">
                  Listo
                </span>
              </li>
              <li class="flex items-center gap-4 px-4 py-3.5">
                <span class="mono w-12 shrink-0 text-[12px] text-ink-2">11:30</span>
                <div class="flex-1">
                  <p class="text-[13px] font-medium text-ink">VW Amarok · AD 908 KL</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">Cambio de aceite y filtro</p>
                </div>
                <span class="mono rounded border border-white/10 bg-paper-2 px-2 py-1 text-[11px] uppercase tracking-wider text-ink-2">
                  En taller
                </span>
              </li>
              <li class="flex items-center gap-4 bg-order/[0.05] px-4 py-3.5">
                <span class="mono w-12 shrink-0 text-[12px] text-order">15:30</span>
                <div class="flex-1">
                  <p class="text-[13px] font-medium text-ink">Toyota Hilux · AE 441 PZ</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">Service 10.000 km · M. Ferreyra</p>
                </div>
                <span class="mono rounded border border-order/40 bg-order/10 px-2 py-1 text-[11px] uppercase tracking-wider text-order">
                  Próximo
                </span>
              </li>
            </ul>
          </Pantalla>

          <Pantalla
            title="Historial del vehículo"
            meta="Hilux AE 441 PZ"
            pie="Cada auto con su historia: qué se le hizo, cuándo y qué le toca."
          >
            <ul class="divide-y divide-line-soft">
              <li class="px-4 py-3">
                <div class="flex items-center justify-between">
                  <p class="text-[12.5px] font-medium text-ink">Service 5.000 km</p>
                  <span class="mono text-[11px] text-ink-3">14/03</span>
                </div>
                <p class="mt-0.5 text-[11.5px] text-ink-3">Aceite 15W40 · filtro W68</p>
              </li>
              <li class="px-4 py-3">
                <div class="flex items-center justify-between">
                  <p class="text-[12.5px] font-medium text-ink">Cambio de cubiertas</p>
                  <span class="mono text-[11px] text-ink-3">02/01</span>
                </div>
                <p class="mt-0.5 text-[11.5px] text-ink-3">Delanteras · alineación</p>
              </li>
            </ul>
            <div class="border-t border-line bg-order/[0.05] px-4 py-3.5">
              <p class="text-[12.5px] font-medium text-order">Próximo service: 10.000 km</p>
              <p class="mt-0.5 text-[11.5px] text-ink-3">
                Recordatorio automático al cliente
              </p>
            </div>
          </Pantalla>
        </div>
      </div>

      <!-- ============================ ECOMMERCE -->
      <div data-rubro-panel="ecommerce">
        <div class="grid gap-x-12 gap-y-14 lg:grid-cols-[1.25fr_1fr]" data-reveal>
          <Pantalla
            title="Stock"
            meta="depósito"
            pie="Así sabés qué te falta antes de que un cliente te lo pregunte."
          >
            <table class="w-full text-left">
              <thead>
                <tr class="mono border-b border-line-soft text-[11px] uppercase tracking-[0.14em] text-ink-3">
                  <th class="px-4 py-2.5 font-normal">Producto</th>
                  <th class="px-4 py-2.5 font-normal">Cantidad</th>
                  <th class="px-4 py-2.5 font-normal">Estado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line-soft">
                <tr class="bg-chaos/[0.06]">
                  <td class="px-4 py-3.5 text-[13px] font-medium text-ink">Bujía NGK BPR6</td>
                  <td class="px-4 py-3.5 text-[12.5px] text-ink-2">0</td>
                  <td class="px-4 py-3.5">
                    <span class="mono rounded border border-chaos/40 bg-chaos/10 px-2 py-1 text-[11px] uppercase tracking-wider text-chaos">
                      Sin stock
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5 text-[13px] font-medium text-ink">Filtro de aceite W68</td>
                  <td class="px-4 py-3.5 text-[12.5px] text-ink-2">4</td>
                  <td class="px-4 py-3.5">
                    <span class="mono rounded border border-order/40 bg-order/10 px-2 py-1 text-[11px] uppercase tracking-wider text-order">
                      Reponer
                    </span>
                  </td>
                </tr>
                <tr>
                  <td class="px-4 py-3.5 text-[13px] font-medium text-ink">Aceite 15W40 · 4L</td>
                  <td class="px-4 py-3.5 text-[12.5px] text-ink-2">22</td>
                  <td class="px-4 py-3.5">
                    <span class="mono rounded border border-white/10 bg-paper-2 px-2 py-1 text-[11px] uppercase tracking-wider text-ink-2">
                      Ok
                    </span>
                  </td>
                </tr>
              </tbody>
            </table>
          </Pantalla>

          <Pantalla
            title="Pedidos"
            meta="hoy"
            pie="El pedido descuenta stock solo. No se carga dos veces en ningún lado."
          >
            <ul class="divide-y divide-line-soft">
              <li class="flex items-center justify-between gap-3 px-4 py-3.5">
                <div>
                  <p class="text-[13px] font-medium text-ink">#1042 · L. Peralta</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">2 productos · pagado</p>
                </div>
                <span class="mono rounded border border-order/40 bg-order/10 px-2 py-1 text-[11px] uppercase tracking-wider text-order">
                  Preparar
                </span>
              </li>
              <li class="flex items-center justify-between gap-3 px-4 py-3.5">
                <div>
                  <p class="text-[13px] font-medium text-ink">#1041 · C. Vega</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">1 producto · envío</p>
                </div>
                <span class="mono rounded border border-white/10 bg-paper-2 px-2 py-1 text-[11px] uppercase tracking-wider text-ink-2">
                  Enviado
                </span>
              </li>
            </ul>
            <div class="grid grid-cols-2 border-t border-line">
              <div class="border-r border-line-soft px-4 py-3.5 text-center">
                <p class="font-display text-[19px] font-semibold text-ink">18</p>
                <p class="mono mt-0.5 text-[11px] uppercase tracking-[0.1em] text-ink-3">
                  Pedidos del mes
                </p>
              </div>
              <div class="px-4 py-3.5 text-center">
                <p class="font-display text-[19px] font-semibold text-order">3</p>
                <p class="mono mt-0.5 text-[11px] uppercase tracking-[0.1em] text-ink-3">
                  Por preparar
                </p>
              </div>
            </div>
          </Pantalla>
        </div>
      </div>

      <!-- ============================ A MEDIDA -->
      <div data-rubro-panel="a-medida">
        <div class="grid gap-x-12 gap-y-14 lg:grid-cols-[1.25fr_1fr]" data-reveal>
          <Pantalla
            title="Tu proceso, tal como es"
            meta="a medida"
            pie="Si tu proceso no entra en una caja, la herramienta se arma alrededor de él."
          >
            <ol class="divide-y divide-line-soft">
              <li class="flex items-center gap-4 px-4 py-3.5">
                <span class="mono flex h-7 w-7 shrink-0 items-center justify-center rounded border border-white/15 text-[11px] text-ink-2">
                  01
                </span>
                <div class="flex-1">
                  <p class="text-[13px] font-medium text-ink">Pedido del cliente</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">Responsable: mostrador</p>
                </div>
                <span class="mono text-[11px] text-ink-3">2 hoy</span>
              </li>
              <li class="flex items-center gap-4 bg-order/[0.05] px-4 py-3.5">
                <span class="mono flex h-7 w-7 shrink-0 items-center justify-center rounded border border-order/40 bg-order/10 text-[11px] text-order">
                  02
                </span>
                <div class="flex-1">
                  <p class="text-[13px] font-medium text-ink">Presupuesto y aprobación</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">Responsable: administración</p>
                </div>
                <span class="mono text-[11px] text-order">1 trabada</span>
              </li>
              <li class="flex items-center gap-4 px-4 py-3.5">
                <span class="mono flex h-7 w-7 shrink-0 items-center justify-center rounded border border-white/15 text-[11px] text-ink-2">
                  03
                </span>
                <div class="flex-1">
                  <p class="text-[13px] font-medium text-ink">Entrega y facturación</p>
                  <p class="mt-0.5 text-[11.5px] text-ink-3">Responsable: depósito</p>
                </div>
                <span class="mono text-[11px] text-ink-3">4 hoy</span>
              </li>
            </ol>
          </Pantalla>

          <Pantalla
            title="Lo que está trabado"
            meta="alertas"
            pie="El sistema te avisa dónde se frena el trabajo, sin que tengas que buscarlo."
          >
            <ul class="divide-y divide-line-soft">
              <li class="px-4 py-3.5">
                <p class="text-[12.5px] font-medium text-ink">Presupuesto sin respuesta</p>
                <p class="mt-0.5 text-[11.5px] text-ink-3">Hace 6 días · cliente C. Vega</p>
              </li>
              <li class="px-4 py-3.5">
                <p class="text-[12.5px] font-medium text-ink">Tarea sin responsable</p>
                <p class="mt-0.5 text-[11.5px] text-ink-3">Control de calidad · lote 214</p>
              </li>
            </ul>
            <div class="border-t border-line px-4 py-3.5">
              <p class="mono text-[11px] uppercase tracking-[0.14em] text-ink-3">
                Nada depende de que alguien se acuerde
              </p>
            </div>
          </Pantalla>
        </div>
      </div>
    </div>
  </div>
</section>
