---
import SectionHead from "./SectionHead.astro";
import { casoIA } from "../../utils/estudio";

// Antes esta sección medía 2,8 pantallas de celular para decir algo que
// entra en una frase. Se fue el orbe WebGL y los ocho chips sueltos:
// queda la postura, las cuatro capas y nada más.
//
// Lo que le faltaba: la postura sola no prueba nada. "No vendemos IA por
// moda" lo escribe cualquiera; lo que separa a quien la sabe usar es
// poder mostrar algo construido Y dónde le pusieron el freno. Eso es el
// bloque de abajo, y sale de `casoIA` en `estudio.ts` (se puede apagar
// desde ahí con `publicable: false`).
//
// La empresa donde corre no se nombra: no hay OK para hacerlo, y la
// capacidad se entiende igual sin el nombre.
const capas = [
  { label: "Datos", detalle: "Dónde vive la información" },
  { label: "Orden", detalle: "Procesos y responsables claros" },
  { label: "Automatización", detalle: "Lo repetitivo, resuelto" },
  { label: "IA", detalle: "Solo donde suma valor" },
];
---

<section id="ia" class="relative overflow-hidden border-b border-line">
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(58% 60% at 82% 40%, rgba(76,110,245,.13), transparent 62%);"
    aria-hidden="true">
  </div>

  <div class="relative mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-12 lg:py-20">
    <div>
      <div>
        <SectionHead tag="Inteligencia artificial" tone="depth">
          IA aplicada con <span class="accent text-order">criterio</span>, no por moda
        </SectionHead>

        <p
          class="mt-7 max-w-[38ch] text-[17px] leading-relaxed text-ink-2"
          data-reveal
          data-reveal-delay="0.08"
        >
          Primero miramos qué se repite y dónde se pierde tiempo. Muchas veces
          la respuesta no es IA: es ordenar el dato.
        </p>

        <blockquote
          class="blade blade--depth mt-7 px-6 py-6"
          style="--blade-d: 12px;"
          data-reveal
          data-reveal-delay="0.12"
        >
          <p class="font-display text-[19px] font-medium leading-snug text-ink sm:text-[21px]">
            No te vamos a vender IA si primero necesitás
            <span class="accent text-order">ordenar tus procesos</span>.
          </p>
        </blockquote>
      </div>

    </div>

    {
      casoIA.publicable && (
        <div class="mt-12 border-t border-line pt-10">
          <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:gap-14">
            <div>
              <p class="mono text-[11px] uppercase tracking-[0.2em] text-ink-3" data-reveal>
                Lo más complejo que construimos con IA
              </p>
              <h3
                class="mt-5 max-w-[16ch] font-display text-d3 font-semibold text-ink"
                data-reveal
                data-reveal-delay="0.05"
              >
                {casoIA.titulo}
              </h3>
              <p
                class="mt-5 max-w-[48ch] text-[15px] leading-relaxed text-ink-2"
                data-reveal
                data-reveal-delay="0.08"
              >
                {casoIA.resumen}
              </p>
            </div>

            <div>
              {/* El freno es el punto de toda la sección: una IA que sabe
                  cuándo NO actuar es la diferencia entre una herramienta
                  y una demo peligrosa. Por eso va destacado y al final. */}
              <div
                class="blade blade--chaos mt-8 px-6 py-6"
                style="--blade-d: 10px;"
                data-reveal
                data-reveal-delay="0.1"
              >
                <p class="tag tag--chaos">Dónde se frena</p>
                <p class="mt-4 max-w-[52ch] font-display text-[16.5px] font-medium leading-snug text-ink">
                  {casoIA.freno}
                </p>
              </div>

              {/* Los guardrails van al final y no arriba: apilado en celular,
                  leer "no entra en loop" antes de saber qué hace el sistema
                  no significa nada. Acá cierran el argumento. */}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    ol {
      --stack: 18px;
    }
  }
</style>
