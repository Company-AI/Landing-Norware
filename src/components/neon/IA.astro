---
import SectionHead from "./SectionHead.astro";

// Antes esta sección medía 2,8 pantallas de celular para decir algo que
// entra en una frase. Se fue el orbe WebGL y los ocho chips sueltos:
// queda la postura, las cuatro capas y nada más.
const capas = [
  { label: "Datos", detalle: "Dónde vive la información" },
  { label: "Orden", detalle: "Procesos y responsables claros" },
  { label: "Automatización", detalle: "Lo repetitivo, resuelto" },
  { label: "IA", detalle: "Solo donde suma valor" },
];
---

<section id="ia" class="relative overflow-hidden border-b border-white/[0.08]">
  <div
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(58% 60% at 82% 40%, rgba(76,110,245,.13), transparent 62%);"
    aria-hidden="true">
  </div>

  <div class="relative mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:px-12 lg:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div>
        <SectionHead index="07" tag="Inteligencia artificial" tone="depth">
          IA aplicada con <span class="accent text-order">criterio</span>, no por moda
        </SectionHead>

        <p
          class="mt-9 max-w-[54ch] text-[16.5px] leading-relaxed text-ink-2"
          data-reveal
          data-reveal-delay="0.08"
        >
          Primero entendemos cómo trabaja tu empresa y qué tareas se repiten.
          Recién ahí definimos si tiene sentido usar IA, una automatización o
          simplemente un sistema más ordenado. Cuando suma, la usamos para
          responder consultas repetitivas, clasificar mensajes, resumir
          información, generar reportes o detectar oportunidades de mejora.
        </p>

        <blockquote
          class="blade blade--depth mt-9 px-7 py-7"
          style="--blade-d: 12px;"
          data-reveal
          data-reveal-delay="0.12"
        >
          <p class="font-display text-[19px] font-medium leading-snug text-ink sm:text-[21px]">
            No te vamos a vender IA si primero necesitás
            <span class="accent text-order">ordenar tus procesos</span>.
          </p>
        </blockquote>
      </div>

      <!-- Las cuatro capas: la IA se apoya en lo de abajo -->
      <div class="lg:pt-24">
        <ol class="space-y-3">
          {
            capas.map((capa, i) => (
              <li
                class:list={[
                  "blade flex items-center gap-5 px-5 py-3.5 sm:px-6",
                  i === capas.length - 1 && "blade--depth",
                ]}
                style={`margin-left: calc(${capas.length - 1 - i} * var(--stack, 0px)); --blade-d: ${5 + i * 3}px;`}
                data-reveal
                data-reveal-delay={String(i * 0.05)}
              >
                <span
                  class:list={[
                    "h-3 w-3 shrink-0 rotate-45 border",
                    i === capas.length - 1
                      ? "border-depth bg-depth/40"
                      : "border-order/70 bg-order/20",
                  ]}
                  aria-hidden="true"
                />
                <div class="flex-1">
                  <p class="font-display text-[15px] font-semibold text-ink">
                    {capa.label}
                  </p>
                  <p class="mt-0.5 text-[13px] text-ink-2">{capa.detalle}</p>
                </div>
                <span class="mono text-[10px] tracking-[0.16em] text-ink-3">
                  0{i + 1}
                </span>
              </li>
            ))
          }
        </ol>
        <p class="mono mt-4 text-[10px] uppercase tracking-[0.18em] text-ink-3">
          Cada capa se apoya en la de abajo
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    ol {
      --stack: 18px;
    }
  }
</style>
