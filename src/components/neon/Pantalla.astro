---
// Ventana del sistema. Marco técnico + barra de título + contenido.
// MOCKUP ILUSTRATIVO: reemplazar por capturas reales cuando estén.
interface Props {
  title: string;
  meta?: string;
  pie?: string;
  class?: string;
}

const { title, meta = "norware", pie, class: klass = "" } = Astro.props;
---

<figure class:list={["relative", klass]}>
  <div class="blade overflow-hidden" style="--blade-d: 10px;">
    <div class="flex items-center justify-between border-b border-line px-4 py-2.5">
      <div class="flex items-center gap-2.5">
        <span
          class="h-1.5 w-1.5 rounded-full bg-order"></span>
        <span class="font-display text-[12.5px] font-medium text-ink">{title}</span>
      </div>
      <span class="flex items-center gap-2.5">
        <!-- Honestidad: hoy son maquetas, no capturas del sistema real. -->
        <span class="mono rounded border border-line-strong px-1.5 py-0.5 text-[11px] uppercase tracking-[0.14em] text-ink-3">
          Ejemplo
        </span>
        <span class="mono text-[11px] uppercase tracking-[0.16em] text-ink-3">
          {meta}
        </span>
      </span>
    </div>

    <div class="relative">
      <slot />
    </div>
  </div>

  {
    pie && (
      <figcaption class="mono mt-4 flex items-start gap-2.5 text-[11px] leading-relaxed text-ink-2">
        <span
          class="mt-[3px] h-2 w-2 shrink-0 rotate-45 border border-order/70 bg-order/30"
          aria-hidden="true"
        />
        {pie}
      </figcaption>
    )
  }
</figure>
