---
import SectionHead from "./SectionHead.astro";
import { whatsappLink } from "../../utils/site";
import {
  precio,
  hayPrecio,
  formatoPrecio,
  implementacion,
} from "../../utils/negocio";

// Lo que un dueño quiere saber antes que nada: cuánto sale y cuándo lo usa.
// Si los números todavía no están cargados en `negocio.ts`, la sección
// muestra una versión honesta sin cifras en vez de inventar una.
const modelos = [
  {
    nombre: "Producto mensual",
    para: "Para inmobiliarias, talleres, ecommerce, stock y soluciones que ya tenemos armadas.",
    incluye: [
      "Setup inicial y configuración",
      "Capacitación del equipo",
      "Soporte cercano",
      "Mejoras y mantenimiento",
    ],
  },
  {
    nombre: "Desarrollo a medida",
    para: "Para empresas con procesos particulares que necesitan una herramienta propia.",
    incluye: [
      "Relevamiento del proceso",
      "Alcance definido",
      "Presupuesto cerrado por proyecto",
      "Desarrollo e implementación",
    ],
  },
];

const ctaConsulta = whatsappLink(
  "Hola Norware, quiero saber qué opción me conviene y cuánto sale."
);
---

<section id="precio" class="relative border-b border-line bg-paper-2">
  <div class="mx-auto max-w-[1200px] px-5 py-14 sm:px-8 lg:px-12 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHead tag="Precio y puesta en marcha">
        Cuánto sale y en cuánto lo estás <span class="accent text-order">usando</span>
      </SectionHead>

      <p
        class="max-w-[52ch] text-[16.5px] leading-relaxed text-ink-2 lg:pt-20"
        data-reveal
        data-reveal-delay="0.08"
      >
        Cuando ya tenemos una solución para tu rubro, la implementamos con un
        setup inicial y un abono mensual. Si tu empresa necesita algo
        específico, relevamos el proceso y armamos un presupuesto cerrado.
      </p>
    </div>

    <!-- Cifras -->
    <div class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        hayPrecio && precio.setupDesde !== null && (
          <div class="blade px-6 py-7" style="--blade-d: 8px;">
            <p class="mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
              Setup inicial
            </p>
            <p class="mt-3 font-display text-d3 font-semibold text-ink">
              desde {formatoPrecio(precio.setupDesde)}
            </p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-ink-2">
              Configuración, carga inicial y capacitación del equipo.
            </p>
          </div>
        )
      }

      {
        hayPrecio && precio.abonoDesde !== null && (
          <div class="blade px-6 py-7" style="--blade-d: 8px;">
            <p class="mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
              Abono mensual
            </p>
            <p class="mt-3 font-display text-d3 font-semibold text-order">
              desde {formatoPrecio(precio.abonoDesde)}
            </p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-ink-2">
              Incluye soporte, mejoras y mantenimiento.
            </p>
          </div>
        )
      }

      {
        implementacion && (
          <div class="blade px-6 py-7" style="--blade-d: 8px;">
            <p class="mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
              Puesta en marcha
            </p>
            <p class="mt-3 font-display text-d3 font-semibold text-order">
              {implementacion.titulo}
            </p>
            <p class="mt-2 text-[13.5px] leading-relaxed text-ink-2">
              {implementacion.detalle}
            </p>
          </div>
        )
      }

      {
        !hayPrecio && (
          <div class="blade px-7 py-8 sm:col-span-2" style="--blade-d: 10px;">
            <p class="mono text-[11px] uppercase tracking-[0.18em] text-ink-3">
              Cuánto sale
            </p>
            <p class="mt-4 max-w-[62ch] font-display text-[19px] font-medium leading-snug text-ink">
              Setup inicial más un abono mensual, o un presupuesto cerrado si es
              a medida. El número depende del rubro y del alcance, y te lo
              damos en la primera charla.
            </p>
            <p class="mt-4 max-w-[58ch] text-[14px] leading-relaxed text-ink-2">
              Sin vueltas y sin propuestas de veinte páginas: nos contás qué
              necesitás y te decimos cuánto es.
            </p>
            <a
              href={ctaConsulta}
              target="_blank"
              rel="noopener"
              class="btn btn-primary mt-7"
            >
              Pedir el número
            </a>
          </div>
        )
      }
    </div>

    {
      hayPrecio && (
        <p class="mt-6 max-w-[62ch] text-[13.5px] leading-relaxed text-ink-3" data-reveal>
          {precio.nota}
        </p>
      )
    }

    <!-- Las dos formas de trabajar, en tabla: ocupa la mitad que en tarjetas -->
    <div class="mt-10 grid border-t border-line md:grid-cols-2" data-reveal>
      {
        modelos.map((modelo, i) => (
          <div
            class:list={[
              "border-b border-line px-1 py-7 sm:px-6",
              i === 0 && "md:border-r",
            ]}
          >
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  "h-3 w-3 rotate-45 border",
                  i === 1 ? "border-depth bg-depth/40" : "border-order bg-order/40",
                ]}
                aria-hidden="true"
              />
              <h3 class="font-display text-[17.5px] font-semibold text-ink">
                {modelo.nombre}
              </h3>
            </div>
            <p class="mt-2.5 max-w-[44ch] text-[14px] leading-relaxed text-ink-2">
              {modelo.para}
            </p>
            <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
              {modelo.incluye.map((item) => (
                <li class="flex items-center gap-2 text-[13px] text-ink-2">
                  <span
                    class="h-[5px] w-[5px] shrink-0 rotate-45 border border-order/70"
                    aria-hidden="true"
                  />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10" data-reveal>
      <a href={ctaConsulta} target="_blank" rel="noopener" class="btn btn-ghost">
        Consultar qué opción me conviene
      </a>
    </div>
  </div>
</section>
