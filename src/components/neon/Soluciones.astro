---
import SectionHead from "./SectionHead.astro";
import { whatsappLink } from "../../utils/site";

// El visitante ya dijo qué rubro tiene en el hero. Acá ve SU tarjeta
// desplegada y las otras tres como filas, a un clic.
// Antes esta sección medía 3,6 pantallas de celular; así mide ~1,5.
const soluciones = [
  {
    id: "inmobiliarias",
    nombre: "Norware Inmobiliarias",
    titulo: "Sistema para inmobiliarias",
    descripcion:
      "Centralizá propiedades, propietarios, inquilinos, contratos, pagos, vencimientos y reportes en un solo lugar.",
    dolores: [
      "Contratos repartidos en carpetas",
      "Pagos controlados con Excel",
      "Vencimientos difíciles de seguir",
      "Consultas repetidas por WhatsApp",
    ],
    resultado:
      "Más control sobre la gestión diaria y menos dependencia de planillas.",
    cta: "Pedir demo",
    whatsapp: "Hola Norware, quiero una demo del sistema para inmobiliarias.",
    tone: "order",
  },
  {
    id: "talleres",
    nombre: "Norware Talleres",
    titulo: "Sistema para talleres y lubricentros",
    descripcion:
      "Organizá clientes, vehículos, historial de services, turnos, stock y recordatorios desde una herramienta simple.",
    dolores: [
      "Historial del vehículo perdido",
      "Turnos en WhatsApp o cuaderno",
      "Stock de filtros y aceites desordenado",
      "Sin seguimiento post service",
    ],
    resultado:
      "Más orden en la atención, más seguimiento y mejor control operativo.",
    cta: "Pedir demo",
    whatsapp:
      "Hola Norware, quiero una demo del sistema para talleres y lubricentros.",
    tone: "depth",
  },
  {
    id: "ecommerce",
    nombre: "Norware Ecommerce",
    titulo: "Ecommerce y control de stock",
    descripcion:
      "Vendé online, gestioná pedidos y mantené tu stock ordenado sin depender de planillas desactualizadas.",
    dolores: [
      "Stock que no coincide",
      "Ventas por Instagram difíciles de seguir",
      "Pedidos cargados a mano",
      "Entregas y pagos sin control",
    ],
    resultado:
      "Una operación comercial más ordenada, medible y preparada para crecer.",
    cta: "Pedir demo",
    whatsapp:
      "Hola Norware, quiero una demo de la solución de ecommerce y stock.",
    tone: "depth",
  },
  {
    id: "a-medida",
    nombre: "Norware a Medida",
    // Reencuadre: el que no está en la lista tiene que verse nombrado.
    titulo: "Tu rubro, aunque no esté en la lista",
    descripcion:
      "Distribuidoras, veterinarias, corralones, consultorios, estudios contables, escuelas. Si tu rubro todavía no tiene una solución armada, diseñamos la herramienta alrededor de tu forma real de trabajar.",
    dolores: [
      "Procesos internos muy específicos",
      "Herramientas genéricas que no se adaptan",
      "Tareas manuales repetitivas",
      "Información dispersa entre plataformas",
    ],
    resultado: "Un sistema pensado para tu operación, no al revés.",
    cta: "Contame mi caso",
    whatsapp:
      "Hola Norware, tengo un proceso particular en mi empresa y quiero hablar sobre un sistema a medida.",
    tone: "order",
  },
];
---

<section id="soluciones" class="relative border-b border-white/[0.08]">
  <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHead index="03" tag="Qué ofrecemos">
        Soluciones para negocios que necesitan más <span class="accent text-order">orden</span> y control
      </SectionHead>

      <p
        class="max-w-[52ch] text-[16.5px] leading-relaxed text-ink-2 lg:pt-20"
        data-reveal
        data-reveal-delay="0.08"
      >
        Si tu negocio hoy depende de planillas, papeles o mensajes, hay algo
        para ordenar. El rubro solo define qué tan armado está el punto de
        partida.
      </p>
    </div>

    <!-- La tarjeta del rubro elegido, desplegada -->
    <div class="scene mt-14">
      {
        soluciones.map((sol) => (
          <div data-rubro-panel={sol.id}>
            <article
              id={sol.id}
              class:list={[
                "blade d3 p-6 sm:p-9",
                sol.tone === "depth" && "blade--depth",
              ]}
              style="--blade-d: 14px;"
              data-tilt
              data-tilt-max="4"
              data-tilt-lift="12"
            >
              <div class="flex items-center justify-between gap-4 border-b border-white/[0.07] pb-5">
                <span
                  class:list={[
                    "mono text-[10px] uppercase tracking-[0.16em]",
                    sol.tone === "depth" ? "text-[#9DB0FF]" : "text-order",
                  ]}
                >
                  {sol.nombre}
                </span>
                <span class="mono text-[10px] tracking-[0.16em] text-ink-3">
                  Tu rubro
                </span>
              </div>

              <div class="grid gap-x-12 gap-y-7 lg:grid-cols-[1.1fr_1fr]">
                <div>
                  <h3 class="mt-6 font-display text-d3 font-semibold text-ink">
                    {sol.titulo}
                  </h3>
                  <p class="mt-3.5 max-w-[52ch] text-[15px] leading-relaxed text-ink-2">
                    {sol.descripcion}
                  </p>

                  <p class="mt-6 border-t border-white/[0.07] pt-5 text-[14.5px] font-medium leading-relaxed text-ink">
                    {sol.resultado}
                  </p>

                  <a
                    href={whatsappLink(sol.whatsapp)}
                    target="_blank"
                    rel="noopener"
                    class="link-arrow mt-6 text-[14.5px]"
                  >
                    {sol.cta}
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </a>
                </div>

                <ul class="layer-1 mt-6 grid gap-2.5 self-start border-l border-white/[0.07] pl-6 lg:mt-6">
                  <li class="mono mb-1 text-[9.5px] uppercase tracking-[0.18em] text-ink-3">
                    Resuelve
                  </li>
                  {sol.dolores.map((dolor) => (
                    <li class="flex items-start gap-2.5 text-[13.5px] leading-snug text-ink-2">
                      <span
                        class:list={[
                          "mt-[6px] h-[7px] w-[7px] shrink-0 rotate-45 border",
                          sol.tone === "depth"
                            ? "border-depth bg-depth/40"
                            : "border-order bg-order/40",
                        ]}
                      />
                      {dolor}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </div>
        ))
      }
    </div>

    <!-- Los otros rubros, a un clic -->
    <div class="mt-10" data-reveal>
      <p class="mono mb-4 text-[10px] uppercase tracking-[0.2em] text-ink-3">
        ¿Tenés otro rubro?
      </p>
      <ul class="grid border-t border-white/[0.08] sm:grid-cols-3">
        {
          soluciones.map((sol) => (
            <li data-rubro-row={sol.id}>
              <button
                type="button"
                data-rubro-btn={sol.id}
                class="fila flex w-full items-center gap-4 border-b border-white/[0.08] px-1 py-5 text-left sm:border-r sm:px-5"
              >
                <span class="flex-1">
                  <span class="mono block text-[9.5px] uppercase tracking-[0.16em] text-ink-3">
                    {sol.nombre}
                  </span>
                  <span class="mt-1.5 block font-display text-[14.5px] font-medium leading-snug text-ink">
                    {sol.titulo}
                  </span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="flecha shrink-0 text-ink-3" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fila {
    transition: background-color 0.3s ease;
  }
  .fila:hover {
    background: rgba(155, 92, 255, 0.05);
  }
  .fila .flecha {
    transition:
      transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1),
      color 0.3s ease;
  }
  .fila:hover .flecha {
    transform: translateX(4px);
    color: var(--order);
  }
  /* La fila del rubro activo no se muestra, así que el borde derecho
     de la última visible no debe quedar colgando. */
  .fila {
    border-color: rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  // Al cambiar de rubro desde las filas, la tarjeta desplegada está arriba:
  // hay que llevar al visitante hasta ella.
  document
    .querySelectorAll("#soluciones [data-rubro-btn]")
    .forEach((btn) =>
      btn.addEventListener("click", () => {
        document
          .getElementById("soluciones")
          ?.scrollIntoView({ behavior: "smooth", block: "start" });
      })
    );
</script>
