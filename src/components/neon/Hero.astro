---
import { site } from "../../utils/site";

// El visitante elige su rubro en la primera pantalla. A partir de ahí la
// página le habla a él: cambia la bajada y la pantalla de producto.
// Las bajadas son condensaciones de las descripciones que ya estaban
// en la sección de soluciones: no hay promesas nuevas.
const rubros = [
  {
    id: "inmobiliarias",
    label: "Inmobiliaria",
    linea:
      "Propiedades, contratos, pagos y vencimientos en un solo lugar. Sin planillas.",
  },
  {
    id: "talleres",
    label: "Taller o lubricentro",
    linea:
      "Turnos, historial de cada vehículo, stock y recordatorios en un solo lugar.",
  },
  {
    id: "ecommerce",
    label: "Comercio o ecommerce",
    linea:
      "Pedidos, stock y ventas online en un solo lugar, siempre actualizado.",
  },
  {
    id: "a-medida",
    label: "Otro rubro",
    linea:
      "Una herramienta hecha para tu proceso, no un sistema genérico al que adaptarte. Cualquiera sea tu rubro.",
  },
];
---

<section class="relative border-b border-white/[0.08]">
  <div class="mx-auto max-w-[1400px] px-5 pt-14 sm:px-8 lg:px-12 lg:pt-16">
    <div class="grid items-start gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10">
      <!-- Mensaje -->
      <div class="lg:pt-4">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2" data-reveal>
          <span class="tag">{site.name} Studio</span>
          <span class="hidden h-px w-10 bg-white/15 sm:block"></span>
          <span class="index">Río Cuarto · Córdoba</span>
        </div>

        <h1
          class="mt-7 max-w-[13ch] font-display text-d1 font-bold text-ink"
          data-reveal
          data-reveal-delay="0.05"
        >
          Sistemas simples para <span class="accent text-order">ordenar</span> tu negocio
        </h1>

        <!-- Bajada concreta, según el rubro elegido -->
        <div class="mt-7 min-h-[3.5rem]" data-reveal data-reveal-delay="0.1">
          {
            rubros.map((r) => (
              <p
                data-rubro-panel={r.id}
                class="max-w-[42ch] text-[18px] leading-relaxed text-ink sm:text-[20px]"
              >
                {r.linea}
              </p>
            ))
          }
        </div>

        <!-- Selector de rubro -->
        <div class="mt-8" data-reveal data-reveal-delay="0.14">
          <p class="mono mb-3.5 text-[10px] uppercase tracking-[0.22em] text-ink-3">
            ¿Qué tenés?
          </p>
          <div class="flex flex-wrap gap-2.5">
            {
              rubros.map((r) => (
                <button
                  type="button"
                  data-rubro-btn={r.id}
                  aria-pressed="false"
                  class="rounded border border-white/[0.14] bg-white/[0.03] px-4 py-2.5 font-display text-[13.5px] font-medium text-ink-2"
                >
                  {r.label}
                </button>
              ))
            }
          </div>
          <p class="mt-3.5 max-w-[58ch] text-[13px] leading-relaxed text-ink-3">
            Si tu negocio hoy funciona con planillas, papeles o mensajes, es
            para vos. Los tres primeros ya los tenemos armados; cualquier otro
            rubro lo hacemos a medida.
          </p>
        </div>

        <div class="mt-9 flex flex-col gap-4 sm:flex-row" data-reveal data-reveal-delay="0.18">
          <a href="#diagnostico" class="btn btn-primary">
            Ver qué ordenar primero
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="#soluciones" data-rubro-go class="btn btn-ghost">
            Ver la solución de mi rubro
          </a>
        </div>

        <p class="mt-6 text-[13.5px] text-ink-3" data-reveal data-reveal-delay="0.22">
          3 preguntas, resultado en pantalla. Sin compromiso y sin dejar datos
          para verlo.
        </p>
      </div>

      <!-- Parcela: la escena 3D, encuadrada -->
      <div class="relative" data-reveal data-reveal-delay="0.12">
        <div class="relative border border-white/[0.1] bg-void-2">
          <span class="tick tick--tl" aria-hidden="true"></span>
          <span class="tick tick--tr" aria-hidden="true"></span>
          <span class="tick tick--bl" aria-hidden="true"></span>
          <span class="tick tick--br" aria-hidden="true"></span>

          <div class="flex items-center justify-between border-b border-white/[0.08] px-4 py-2.5">
            <span class="mono text-[10px] uppercase tracking-[0.16em] text-ink-2">
              Desorden → sistema
            </span>
            <span class="mono flex items-center gap-2 text-[10px] uppercase tracking-[0.16em] text-order">
              <span class="h-1.5 w-1.5 rounded-full bg-order" style="box-shadow:0 0 8px rgba(155,92,255,.9)"></span>
              Ensamblando
            </span>
          </div>

          <div class="relative aspect-[4/3] w-full">
            <canvas id="nw-hero-canvas" class="h-full w-full" aria-hidden="true"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "../../scripts/rubro";

  const canvas = document.getElementById("nw-hero-canvas");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = Boolean((navigator as any).connection?.saveData);

  if (canvas instanceof HTMLCanvasElement && !reduce && !saveData) {
    import("../../scripts/hero-scene")
      .then((m) => m.initHeroScene(canvas))
      .catch(() => {});
  }
</script>
