---
import SectionHead from "./SectionHead.astro";
import { faq } from "../../utils/negocio";
import { whatsappDefault } from "../../utils/site";

// Las preguntas que un dueño hace antes de contratar. Cada respuesta sale
// de algo que la web ya afirma (modelo comercial, proceso, soluciones).
// Las que faltan están listadas en `faqPendientes` dentro de negocio.ts.
---

<section id="faq" class="relative border-b border-white/[0.08]">
  <div class="mx-auto max-w-[1400px] px-5 py-20 sm:px-8 lg:px-12 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <SectionHead index="08" tag="Antes de contratar">
        Lo que te vas a preguntar <span class="accent text-order">ahora</span>
      </SectionHead>

      <p
        class="max-w-[52ch] text-[16.5px] leading-relaxed text-ink-2 lg:pt-20"
        data-reveal
        data-reveal-delay="0.08"
      >
        Si te queda alguna sin responder, escribinos y la contestamos derecho
        viejo.
      </p>
    </div>

    <div class="mt-14 border-t border-white/[0.08]">
      {
        faq.map((item, i) => (
          <details class="faq group border-b border-white/[0.08]">
            <summary class="flex cursor-pointer list-none items-start gap-5 py-6 pr-4">
              <span class="mono mt-1 shrink-0 text-[10.5px] tracking-[0.16em] text-ink-3">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="flex-1 font-display text-[17px] font-medium leading-snug text-ink sm:text-[19px]">
                {item.q}
              </span>
              <span class="signo mt-1.5 shrink-0" aria-hidden="true" />
            </summary>
            <p class="max-w-[70ch] pb-7 pl-[3.1rem] pr-4 text-[15px] leading-relaxed text-ink-2">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center" data-reveal>
      <p class="text-[15px] text-ink-2">¿Te quedó otra duda?</p>
      <a href={whatsappDefault} target="_blank" rel="noopener" class="link-arrow text-[15px]">
        Preguntanos por WhatsApp
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq {
    transition: background-color 0.3s ease;
  }
  .faq:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  /* Cruz que gira a menos al abrir */
  .signo {
    position: relative;
    display: block;
    width: 14px;
    height: 14px;
  }
  .signo::before,
  .signo::after {
    content: "";
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--order);
    transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .signo::before {
    width: 14px;
    height: 1.5px;
  }
  .signo::after {
    width: 1.5px;
    height: 14px;
  }
  .faq[open] .signo::after {
    transform: rotate(90deg) scaleX(0);
  }
  .faq[open] .signo::before {
    transform: rotate(180deg);
  }
</style>
