---
import PrimeLayout from "../layouts/PrimeLayout.astro";
import Nav from "../components/prime/Nav.astro";
import Hero from "../components/prime/Hero.astro";
import Ticker from "../components/prime/Ticker.astro";
import ComoFunciona from "../components/prime/ComoFunciona.astro";
import Productos from "../components/prime/Productos.astro";
import Casos from "../components/prime/Casos.astro";
import Rubros from "../components/prime/Rubros.astro";
import Confianza from "../components/prime/Confianza.astro";
import Resultados from "../components/prime/Resultados.astro";
import CTAFinal from "../components/prime/CTAFinal.astro";
import Footer from "../components/prime/Footer.astro";

/*
 * Home rediseñada sobre un patrón de "hoja deslizante":
 *
 *   - El hero queda FIJO a pantalla completa, con su carrusel de
 *     pestañas (estudio / inmobiliarias / talleres / comercios).
 *   - Todo lo demás vive en <main>, una hoja clara con esquinas
 *     redondeadas que se desliza POR ENCIMA del hero al scrollear.
 *
 * Orden del contenido:
 *   Ticker        clientes y productos reales
 *   Cómo funciona diagrama caos → sistema
 *   Productos     4 tarjetas (IN / AF / Tap / holamappi)
 *   Casos         carrusel de frases descriptivas (sin testimonios
 *                 inventados; ver nota en utils/prime.ts)
 *   Rubros        carrusel por rubro
 *   Confianza     criterio (IA, datos, soporte)
 *   Resultados    cifras reales con foto
 *   Contacto      CTA final con malla de color
 *
 * La versión anterior de la home (componentes `neon/`) sigue intacta
 * en el repo por si hay que volver.
 */
---

<PrimeLayout title="Sistemas simples para negocios reales">
  <Nav />
  <Hero />

  <!-- La hoja: tapa el hero al scrollear -->
  <main
    id="contenido"
    class="relative z-10 -mt-4 rounded-t-2xl bg-[#FAF9F8] pb-0 shadow-[0_-12px_40px_rgba(0,0,0,0.18)]"
  >
    <Ticker />
    <ComoFunciona />
    <Productos />
    <Casos />
    <Rubros />
    <Confianza />
    <Resultados />
    <CTAFinal />
    <Footer />
  </main>
</PrimeLayout>
